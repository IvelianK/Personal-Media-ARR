# Copia este fichero a .env (permisos 600) y rellénalo. .env nunca va a git.

# Carpeta raíz del stack en el host. Se monta como /data en todos los contenedores.
MEDIA_ROOT=/mnt/pool/apps/media

# Usuario y grupo dueños de MEDIA_ROOT (568 es el usuario "apps" de TrueNAS)
PUID=568
PGID=568
TZ=Europe/Madrid

# Interfaz donde escuchan las apps de gestión. 127.0.0.1 si hay proxy inverso delante.
BIND=127.0.0.1
# Jellyfin suele escuchar en la IP local del servidor para las apps de TV
JELLYFIN_BIND=127.0.0.1
JELLYFIN_URL=https://jellyfin.example.com

# GID del grupo "render" del host: getent group render
RENDER_GID=107

# Claves de API que generan Sonarr y Radarr al arrancar (Settings > General).
# Las usa langguard para borrar ficheros y marcar releases como fallidas.
SONARR_API_KEY=
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
RADARR_URL=http://radarr:7878
DOWNLOADS=/data/descargas

# Idioma de audio exigido (ISO 639-2) y excepciones por carpeta (ruta=idioma, separadas por comas)
LANG_DEFAULT=spa
LANG_BY_ROOT=/data/biblioteca/anime/=jpn

# Segundos entre rescates de importaciones (0 lo desactiva)
RESCUE_INTERVAL=600

# Usuario y clave del webhook (usuario:clave). Ponlos también en el webhook de Sonarr y Radarr.
# Obligatorio: langguard no arranca sin este valor.
WEBHOOK_AUTH=
